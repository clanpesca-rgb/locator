# Copia questo file in ".env" (nella stessa cartella) e inserisci i valori veri.
# Il file .env è nel .gitignore: le chiavi NON finiscono mai su GitHub.

# Token di accesso Instagram (Meta for Developers, dura ~60 giorni)
IG_TOKEN=

# ID dell'account Instagram business
IG_USER_ID=17841400368031833

# Chiave API Anthropic (console.anthropic.com)
CLAUDE_API_KEY=

# Email
EMAIL_MITTENTE=clanpesca@gmail.com
# ATTENZIONE: qui va la "Password per le app" di Google (16 caratteri),
# NON la password normale di Gmail.
# Si genera da: Account Google → Sicurezza → Verifica in due passaggi → Password per le app
EMAIL_PASSWORD=
EMAIL_DESTINATARIO=clanpesca@gmail.com
